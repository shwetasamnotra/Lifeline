# LIFELINE 2.0 - Environment Variables Example
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.

# ==================================================
# 1. OPEN-METEO (No API key required)
#    Official docs: https://open-meteo.com/
#    Provides: Weather, precipitation, forecast data
# ==================================================
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ==================================================
# 2. USGS EARTHQUAKE API (No API key required)
#    Official docs: https://earthquake.usgs.gov/fdsnws/event/1/
#    Provides: Real-time earthquake feed data
# ==================================================
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1

# ==================================================
# 3. GDACS - Global Disaster Alert and Coordination System
#    Official docs: https://www.gdacs.org/
#    Provides: Global multi-hazard disaster information
#    Note: Check GDACS Terms of Service before use.
# ==================================================
GDACS_BASE_URL=https://www.gdacs.org

# ==================================================
# 4. MAP PROVIDER
#    Default uses OpenStreetMap tiles (no key required)
#    For Mapbox or other providers, set MAP_PROVIDER and MAP_API_KEY.
#    Get Mapbox key at: https://account.mapbox.com/
# ==================================================
MAP_PROVIDER=openstreetmap
MAP_API_KEY=

# ==================================================
# 5. OPTIONAL ROUTING SERVICE
#    Used for advanced road-network routing.
#    If not set, the application uses its own Dijkstra/A* engine.
#    For OSRM (self-hosted, free): https://project-osrm.org/
#    For OpenRouteService (free tier): https://openrouteservice.org/
# ==================================================
ROUTING_PROVIDER=internal
ROUTING_API_KEY=

# ==================================================
# BACKEND SETTINGS
# ==================================================
DATABASE_URL=sqlite+aiosqlite:///./lifeline.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================================================
# FRONTEND SETTINGS (for Vite build)
# ==================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
VITE_APP_MODE=simulation
